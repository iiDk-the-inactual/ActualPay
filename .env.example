# ActualPay configuration. Copy to .env and fill in.
# Every *secret* below can instead be provided as a file via <NAME>_FILE
# (Docker/Kubernetes secrets), e.g. SESSION_SECRET_FILE=/run/secrets/session.
# Never commit a real .env.

# development | test | staging | production
APP_ENV=development
APP_NAME=ActualPay
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info
# Set to true only when running behind a reverse proxy you control.
TRUST_PROXY=false

# --- API server ---
# Use 0.0.0.0 inside containers; keep 127.0.0.1 for local development.
API_HOST=127.0.0.1
API_PORT=3000
# Exact origins (comma-separated) allowed to call the API from browsers with
# API keys. Leave empty unless you need it. Cookies are never sent cross-origin.
CORS_ALLOWED_ORIGINS=

# --- Sessions and login protection ---
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=24
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15
# Per-IP limit on authentication endpoints, and per-caller limit on the API.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=600

# --- Datastores (values match docker-compose.yml for local dev) ---
DATABASE_URL=postgres://actualpay:actualpay-dev-only@localhost:5432/actualpay_dev
DATABASE_POOL_MAX=10
DATABASE_SSL=false
REDIS_URL=redis://:actualpay-dev-only@localhost:6379
# Used only by integration tests; the name MUST end in _test.
TEST_DATABASE_URL=postgres://actualpay:actualpay-dev-only@localhost:5432/actualpay_test
# Used only by integration tests; logical database 15 is FLUSHED by the tests.
TEST_REDIS_URL=redis://:actualpay-dev-only@localhost:6379/15
# Optional chain integration tests (skipped when unset). LOCAL DEV CHAINS ONLY.
# EVM_TEST_RPC_URL=http://127.0.0.1:8545            # anvil --chain-id 31337
# UTXO_REGTEST_URL=http://user:pass@127.0.0.1:19443 # bitcoind/litecoind -regtest
# UTXO_REGTEST_CHAIN=litecoin                       # or bitcoin

# --- Secrets: generate fresh values, e.g.
#   openssl rand -hex 32      (SESSION_SECRET)
#   openssl rand -base64 32   (ENCRYPTION_KEY, must decode to exactly 32 bytes)
# Losing ENCRYPTION_KEY makes encrypted wallet material unrecoverable: back it up separately.
SESSION_SECRET=change-me
ENCRYPTION_KEY=change-me

# --- Chains ---
# mainnet | testnet. Production requires mainnet; use APP_ENV=staging for testnet.
NETWORK_MODE=testnet
# Comma-separated: btc, ltc, eth, usdt-erc20, trx, usdt-trc20, xrp
# Tokens require their fee asset (usdt-erc20 -> eth, usdt-trc20 -> trx).
ENABLED_ASSETS=xrp

# Chain backends: see docs/chains.md for what each needs and why.
# Check connectivity at any time with: npm run chain:probe

# Required when btc is enabled: your own Bitcoin Core (v30+), RPC reachable.
BITCOIN_RPC_URL=
BITCOIN_RPC_USERNAME=
BITCOIN_RPC_PASSWORD=
BITCOIN_WALLET_NAME=actualpay_watch
BITCOIN_CONFIRMATIONS=2
# Required when ltc is enabled: your own Litecoin Core (0.21.x).
LITECOIN_RPC_URL=
LITECOIN_RPC_USERNAME=
LITECOIN_RPC_PASSWORD=
LITECOIN_WALLET_NAME=actualpay_watch
LITECOIN_CONFIRMATIONS=6
# Official Litecoin Core builds lack descriptor wallets, so 'legacy' is the default.
LITECOIN_WALLET_MODE=legacy
# Required when eth or usdt-erc20 is enabled (own node or provider).
# Must support the 'finalized' block tag (all post-Merge clients do).
ETHEREUM_RPC_URL=
# Defaults: 1 on mainnet, 11155111 (Sepolia) on testnet. The adapter refuses
# an endpoint whose chain id differs.
ETHEREUM_CHAIN_ID=
# Required when trx or usdt-trc20 is enabled
TRON_API_URL=
TRON_API_KEY=
# Required when xrp is enabled. Public XRPL testnet: wss://s.altnet.rippletest.net:51233
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
# Classic r-address that receives XRP payments (destination tags identify invoices).
XRPL_DEPOSIT_ACCOUNT=

# Token contracts: on mainnet the official contracts are built in and cannot
# be overridden. Testnets have no official USDT, so set a test token here.
USDT_ERC20_CONTRACT=
USDT_TRC20_CONTRACT=

# --- Email ---
# Optional in development: without SMTP, emails (including one-time links) are
# written to the API log. REQUIRED in production. HOST/PORT/FROM go together.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
