# Non-secret settings for deploy/docker-compose.prod.yml. Copy to deploy/.env.
# Secrets are NOT here: they are files under deploy/secrets/ (see docs/deployment.md).
ACTUALPAY_IMAGE=ghcr.io/your-org/actualpay:1.0.0
ACTUALPAY_DOMAIN=pay.example.com
ACME_EMAIL=ops@example.com
PUBLIC_BASE_URL=https://pay.example.com

# mainnet for real money; testnet for staging (production APP_ENV still requires mainnet,
# so use a separate staging stack with APP_ENV=staging for testnet rehearsals).
NETWORK_MODE=mainnet
ENABLED_ASSETS=btc,eth
# merchant (default, recommended) or platform (you hold funds; read docs/threat-model.md first)
CUSTODY_MODE=merchant

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=ActualPay <no-reply@example.com>
OPERATOR_ALERT_EMAIL=oncall@example.com

# Your own nodes (reachable from the worker, ideally on a private network).
BITCOIN_RPC_URL=
BITCOIN_RPC_USERNAME=
ETHEREUM_RPC_URL=
XRPL_WS_URL=
TRON_API_URL=
LOG_LEVEL=info
